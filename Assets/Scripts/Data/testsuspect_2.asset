  personality: "\uC0AC\uB9AC\uBD84\uBCC4\uC774 \uC815\uD655\uD558\uACE0 \uB17C\uB9AC\uC801\uC778
    \uC131\uACA9\uC774\uB2E4. \uC6A9\uC758\uC790\uB85C \uBD88\uB824\uC628 \uC0C1\uD669\uC5D0
    \uB300\uD574 \uC815\uD655\uD788 \uC778\uC9C0\uD558\uACE0 \uACB0\uBC31\uC744 \uC99D\uBA85\uD558\uB824
    \uD55C\uB2E4."
  speakingStyle: "\uB300\uCCB4\uB85C \uCC28\uAC00\uC6B4 \uB9D0\uD22C\uC774\uC9C0\uB9CC
    \uC815\uC911\uD55C \uD0DC\uB3C4\uB97C \uC720\uC9C0\uD55C\uB2E4. \uC0AC\uD68C\uC0DD\uD65C\uC6A9
    \uBA58\uD2B8\uB97C \uC911\uAC04\uC911\uAC04 \uC11E\uACE0, \uCCAD\uC790\uC758
