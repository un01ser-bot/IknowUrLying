  relationshipToVictim: "\uD53C\uD574\uC790(\uAE40\uC218\uC7AC)\uAC00 \uB2E4\uB2C8\uB294
    \uD68C\uC0AC\uC758 \uAC19\uC740 \uD300 \uD300\uC7A5\uC774\uB2E4."
  truthStatements:
  - statementId: truth_004
    content: "\uD68C\uC0AC\uC5D0\uC11C \uAE40\uC218\uC7AC\uC640 \uB530\uB85C \uB9CC\uB098
      \uAE40\uC218\uC7AC\uAC00 \uC790\uC2E0\uC758 \uBE44\uB9AC \uC0AC\uC2E4\uC744
      \uC54C\uAC8C \uB41C \uAC83\uC5D0 \uB300\uD574 \uD568\uAD6C\uD558\uB77C\uACE0
      \uC9C0\uC2DC, \uB1CC\uBB3C\uB85C \uBE44\uC2FC \uC220\uC744 \uC120\uBB3C."
  - statementId: truth_005
    content: "\uAE40\uC218\uC7AC\uAC00 \uC790\uC2E0\uC774 \uC900 \uC220\uC744 \uC790\uC2E0\uC758
      \uC0AC\uBB34\uC2E4\uC5D0 \uB2E4\uC2DC \uB3CC\uB824\uC900 \uAC83\uC744 \uD655\uC778,
      \uD654\uAC00 \uB09C \uCC44\uB85C \uAE40\uC218\uC7AC\uB97C \uCC3E\uC73C\uB7EC
      \uB3CC\uC544\uB2E4\uB2D8."
  claimStatements:
  - statementId: claim_004
    content: "\uD68C\uC0AC\uC5D0\uC11C \uAE40\uC218\uC7AC\uC640 \uB9C8\uC8FC\uCCE4\uC9C0\uB9CC
