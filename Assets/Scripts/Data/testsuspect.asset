  personality: "\uC790\uC874\uC2EC\uC774 \uAC15\uD558\uACE0 \uC790\uC2E0\uC774 \uC758\uC2EC\uBC1B\uB294
    \uAC83\uC744 \uBD88\uCF8C\uD574\uD55C\uB2E4."
  speakingStyle: "\uC874\uB313\uB9D0\uC744 \uC0AC\uC6A9\uD558\uC9C0\uB9CC \uB2E4\uC18C
    \uD22C\uB35C\uB304\uB2E4. \uBD88\uCF8C\uD55C \uAE30\uBD84\uC744 \uB4DC\uB7EC\uB0B4\uC9C0\uB9CC
    \uC9C1\uC811\uC801\uC73C\uB85C \uBD88\uCF8C\uD558\uB2E4\uACE0 \uB9D0\uD558\uC9C0\uB294
    \uC54A\uB294\uB2E4. \uB9D0\uD22C \uC0AC\uC774\uC5D0 \uD55C\uC228\uC744 \uC26C\uAC70\uB098
    \uC695\uC124\uC744 \uC11E\uAE30\uB3C4 \uD568. \uD53C\uD574\uC790\uB97C \uC774\uB984(\uC218\uC7AC)\uC73C\uB85C
    \uBD80\uB984."
  relationshipToVictim: "\uD53C\uD574\uC790(\uAE40\uC218\uC7AC)\uC640 \uC885\uC885
    \uD53C\uC2DC\uBC29\uC5D0 \uAC00\uAC70\uB098 \uC220\uC744 \uB9C8\uC2DC\uB294 \uB3D9\uB124
    \uCE5C\uAD6C.\n\uBC31\uC218\uC778 \uC790\uC2E0\uACFC \uB2EC\uB9AC \uBC88\uB4EF\uD55C
    \uC9C1\uC7A5\uC744 \uB2E4\uB2C8\uB294 \uD53C\uD574\uC790\uC5D0\uAC8C \uC790\uACA9\uC9C0\uC2EC\uC744
    \uAC00\uC9C0\uACE0 \uC788\uC74C."
  truthStatements:
  - statementId: truth_001
    content: "\uC0AC\uAC74 \uC804\uB0A0 19\uC2DC\uCBE4 \uD53C\uD574\uC790\uC640 \uD53C\uC2DC\uBC29\uC5D0\uC11C
      \uB9CC\uB098 \uAC8C\uC784\uC744 \uD558\uB2E4\uAC00 \uD53C\uD574\uC790\uC640
      \uB9D0\uB2E4\uD23C"
  - statementId: truth_002
    content: "\uD654\uD574\uB97C \uC704\uD574 \uAC01\uC790 \uC9D1\uC5D0 \uB4E4\uB800\uB2E4\uAC00
      22\uC2DC\uAE4C\uC9C0 \uC220\uC9D1\uC5D0\uC11C \uB9CC\uB098\uAE30\uB85C \uC57D\uC18D\uD568"
  - statementId: truth_003
    content: "21\uC2DC 50\uBD84\uCBE4 \uD53C\uD574\uC790\uC758 \uC9D1 \uADFC\uCC98\uC5D0
      \uCC3E\uC544\uAC10"
  claimStatements:
  - statementId: claim_001
    content: "\uC0AC\uAC74 \uB2F9\uC77C \uD53C\uD574\uC790 \uD1F4\uADFC \uD6C4 \uB3D9\uB124\uC5D0\uC11C
      \uAC19\uC774 \uC990\uAC81\uAC8C \uAC8C\uC784\uD568 \uD2B9\uC774\uC0AC\uD56D\uC5C6\uC5C8\uC74C"
    isLie: 1
  - statementId: claim_002
    content: "\uAC8C\uC784 \uD6C4 \uAC01\uC790 \uC9D1\uC5D0 \uB4E4\uB800\uB2E4\uAC00
      \uC220 \uD55C\uC794 \uD558\uAE30\uB85C \uC57D\uC18D\uD588\uC74C"
    isLie: 0
  - statementId: claim_003
    content: "\uC57D\uC18D \uC2DC\uAC04\uC774 \uB418\uC5C8\uB294\uB370 \uD53C\uD574\uC790\uAC00
